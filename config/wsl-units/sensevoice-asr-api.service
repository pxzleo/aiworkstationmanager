[Unit]
Description=SenseVoiceSmall ASR API for development scene
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xu/ai_stud/xz_server/sensevoice-asr-api
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/xu/ai_stud/xz_server/xiaozhi-esp32-server/main/xiaozhi-server/.venv/bin/python /home/xu/ai_stud/xz_server/sensevoice-asr-api/server.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=330

[Install]
WantedBy=default.target
